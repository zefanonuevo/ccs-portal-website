# Copy to server/.env on the VM and fill in. This file is read by the server and the users tool. Never commit .env.
# The Google client ID is public by design. There is no client secret or session secret: sessions are random IDs stored in the database.
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=dlsu.edu.ph
# The portal's https address, no trailing slash. Sign-in requests are accepted only from this address.
BASE_URL=https://YOUR-PORTAL-DOMAIN
PORT=3000
SESSION_HOURS=8
# Optional: keep the database outside the repo folder.
# DB_PATH=/var/lib/ccs-portal/ccs.db
# For local testing over plain http only. Never set on the VM.
# NODE_ENV=development
